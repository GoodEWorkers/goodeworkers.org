---
import { getLangFromPath, routes } from '../i18n/routes';
import { t } from '../i18n/ui';

const lang = getLangFromPath(Astro.url.pathname);
const { form } = t(lang);

// Post to the same-language thank-you page so the visitor stays in French
// when they wrote from /fr/.
const thanksAction = `${routes.home[lang]}thanks/`;

// Shared field classes. These fields previously zeroed the focus ring:
// @tailwindcss/forms suppresses the *native* focus outline and substitutes its
// own ring, so cancelling that substitute as well left focused and unfocused
// inputs pixel-identical (WCAG 2.4.7 failure). A visible ring is restored below.
const fieldClass =
  'peer w-full bg-white border-x-0 border-t-0 border-b-2 border-black px-0 text-base ' +
  'focus:ring-2 focus:ring-orange focus:ring-offset-1 focus:border-orange';

// The float is driven by `:not(:placeholder-shown)` with a single-space
// placeholder, rather than by making the placeholder transparent. Hiding it with
// `color: transparent` breaks in Windows High Contrast / forced-colors mode,
// where author colours are overridden and the placeholder reappears directly on
// top of the identically-worded label.
const labelClass =
  'absolute left-0 top-1 text-base text-gray-500 cursor-text transition-all ' +
  'peer-focus:-top-5 peer-focus:text-sm peer-focus:text-gray-600 ' +
  'peer-[:not(:placeholder-shown)]:-top-5 peer-[:not(:placeholder-shown)]:text-sm ' +
  'peer-[:not(:placeholder-shown)]:text-gray-600';
---

<form
  class="flex flex-col md:flex-row md:space-x-20"
  name="contact"
  method="POST"
  action={thanksAction}
  data-netlify="true"
  data-netlify-honeypot="bot-field"
>
  <div class="flex flex-col md:flex-1">
    <input type="hidden" name="form-name" value="contact" />
    <input type="hidden" name="locale" value={lang} />

    <!-- Records which CTA the visitor arrived from. Populated by the script at
         the bottom of this file from the ?from= query parameter; simply stays
         empty when absent or when JS is unavailable. -->
    <input type="hidden" name="source" value="" data-source-field />

    <!-- Honeypot. Bots fill every field they find; humans never see this one. -->
    <p class="hidden" aria-hidden="true">
      <label>
        Do not fill this in
        <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="relative mt-14">
      <input
        class={`${fieldClass} pt-0 pb-1 h-10`}
        type="text"
        name="name"
        id="name"
        placeholder=" "
        autocomplete="name"
        required
      />
      <label for="name" class={labelClass}>{form.name}</label>
    </div>

    <div class="relative mt-16">
      <input
        class={`${fieldClass} pt-0 pb-1 h-10`}
        type="email"
        name="email"
        id="email"
        placeholder=" "
        autocomplete="email"
        required
      />
      <label for="email" class={labelClass}>{form.email}</label>
    </div>

    <div class="relative mt-16">
      <textarea
        class={`${fieldClass} pt-4 pb-2 h-40`}
        name="message"
        id="message"
        placeholder=" "
        required></textarea>
      <label for="message" class={`${labelClass} top-5`}>{form.message}</label>
    </div>

    <!-- GDPR Art. 13 notice at the point of collection. Replying to an inbound
         enquiry rests on legitimate interest, so a consent checkbox is not
         strictly required — but informing the visitor is. -->
    <p class="mt-8 text-xs text-gray-600 max-w-prose">
      {form.gdprNotice} <a
        href={routes.legal[lang]}
        class="underline">{form.gdprLinkLabel}</a
      >.
    </p>
  </div>

  <div
    class="mt-16 md:mt-0 flex flex-col md:flex-1 items-center md:items-start md:justify-end"
  >
    <!--
      A real <button type="submit">.

      This was previously a styled <label for="submit"> wrapping
      <input type="submit" class="hidden">. Because `.hidden` is
      `display: none`, the input was removed from the tab order *and* from the
      accessibility tree, and a <label> is never focusable and exposes no
      interactive role — so the form had no submit control for keyboard or
      screen-reader users at all. It worked with a mouse only, because <label>
      forwards click activation even to a display:none control.

      The label is `text-white-pure`, not `text-white`: the design calls for a
      white label on the orange CTA (issue #48), but the brand off-white
      (#F8F8F8) computes to 2.92:1 on #FD5E09 — under the 3:1 floor that the
      36px bold label needs. Pure #FFF on the same orange is 3.10:1 and passes.
    -->
    <button
      type="submit"
      class="w-full max-w-[336px] bg-orange text-white-pure px-7 py-5 rounded-full
             flex flex-col items-center hover:scale-105
             transition-transform ease-in
             focus-visible:outline focus-visible:outline-2
             focus-visible:outline-offset-2 focus-visible:outline-black"
    >
      <span class="text-3xl sm:text-4xl font-clash font-bold text-center">
        {form.send}
      </span>
    </button>

    {form.replyNote && (
      <p class="mt-4 text-sm text-gray-600 max-w-[336px] text-center md:text-left">
        {form.replyNote}
      </p>
    )}
  </div>
</form>

<script>
  // Carry the originating CTA through to the submission. Every CTA on the site
  // points at the localized #contact anchor, so without this there is no way
  // to tell them apart.
  function setupSourceField() {
    const field = document.querySelector<HTMLInputElement>('[data-source-field]');
    if (!field) return;
    const from = new URLSearchParams(window.location.search).get('from');
    if (from) field.value = from.slice(0, 64);
  }

  setupSourceField();
  document.addEventListener('astro:page-load', setupSourceField);
</script>

---
import Icon from '../icons/Icon.astro';
import ExternalLink from '../ExternalLink.astro';
import { boardHost, boardSlug, foldText, type JobBoardsContent } from '../../i18n/jobBoards';
import { categoryDot } from './categoryColors';

interface Props {
  content: JobBoardsContent;
}

const { content } = Astro.props;
const { table } = content;

const total = content.rows.length;
const category = new Map(content.categories.map((c) => [c.id, c]));
const accessOptions = (['direct', 'login'] as const).map((id) => ({
  id,
  label: table.accessLabels[id],
  count: content.rows.filter((row) => row.access === id).length,
}));
// utm_campaign on every board link, so each board can tell this page apart.
const campaign = 'remote-job-boards';
const showing = (shown: number) =>
  table.showing.replace('{shown}', String(shown)).replace('{total}', String(total));

const pill =
  'group inline-flex items-center gap-1.5 md:gap-2 rounded-full border-2 border-black px-3 md:px-4 py-1 md:py-1.5 ' +
  'text-xs md:text-sm font-bold transition-colors duration-200 hover:bg-grey aria-pressed:bg-black aria-pressed:text-grey ' +
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange';
const pillCount = 'font-medium text-black/60 group-aria-pressed:text-grey/70';
// The ring keeps the black freelance dot visible on a pressed (black) pill.
const pillDot = 'w-2.5 h-2.5 rounded-full shrink-0 group-aria-pressed:ring-1 group-aria-pressed:ring-grey';
// Open padlock for a direct link, closed for a login: shape, not colour, tells them apart.
const accessIcon = { direct: 'M7 11V7a5 5 0 0 1 9.9-1', login: 'M7 11V7a5 5 0 0 1 10 0v4' };
---

<section
  aria-labelledby="table-title"
  class="sheet mt-12 md:mt-16 pt-8 md:pt-12 pb-10 md:pb-14 bg-white text-black"
  data-board-table
>
  <h2 id="table-title" class="text-2xl md:text-3xl lg:text-4xl font-medium leading-tight">
    {table.title}
  </h2>

  <!-- On wide screens the filters stick under the navbar (101px tall once
       stuck), so the list can be narrowed from anywhere in the table. -->
  <!-- taste-skill-ignore: invisible sentinel for the sticky toolbar --><span class="block h-px" aria-hidden="true" data-toolbar-sentinel></span>
  <div
    class="toolbar lg:sticky lg:top-[101px] z-30 -mx-4 md:-mx-8 px-4 md:px-8 pt-5 md:pt-7 pb-4 bg-white"
    data-board-toolbar
  >
    <div role="group" aria-label={table.kindFilter} class="flex flex-wrap gap-1.5 md:gap-2">
      <button type="button" aria-pressed="true" data-kind-filter="all" class={pill}>
        {table.all}
        <span class={pillCount}>{total}</span>
      </button>
      {
        content.categories.map((c) => (
          <button type="button" aria-pressed="false" data-kind-filter={c.id} class={pill}>
            <span class:list={[pillDot, categoryDot[c.color]]} aria-hidden="true" />
            {c.label}
            <span class={pillCount}>{c.count}</span>
          </button>
        ))
      }
    </div>
    <div role="group" aria-label={table.access} class="mt-3 flex flex-wrap items-center gap-1.5 md:gap-2">
      <span class="mr-1 text-xs md:text-sm font-bold">{table.access}</span>
      <button type="button" aria-pressed="true" data-access-filter="all" class={pill}>
        {table.all}
        <span class={pillCount}>{total}</span>
      </button>
      {
        accessOptions.map((option) => (
          <button type="button" aria-pressed="false" data-access-filter={option.id} class={pill}>
            {option.label}
            <span class={pillCount}>{option.count}</span>
          </button>
        ))
      }
    </div>
    <div class="mt-5 md:mt-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="w-full md:max-w-sm">
        <label for="board-search" class="block text-sm font-bold">{table.search}</label>
        <input
          id="board-search"
          type="search"
          autocomplete="off"
          placeholder={table.searchPlaceholder}
          data-board-search
          class="mt-1 w-full bg-transparent border-x-0 border-t-0 border-b-2 border-black px-0 py-1.5 text-base caret-orange placeholder:text-black/60 focus:ring-2 focus:ring-orange focus:ring-offset-1 focus:border-orange"
        />
      </div>
      <p class="text-sm text-black/70" aria-live="polite" data-board-count data-template={table.showing}>
        {showing(total)}
      </p>
    </div>
  </div>

  <table class="mt-2 w-full border-collapse text-left" data-board-list>
    <thead class="max-md:sr-only">
      <tr class="border-b-2 border-black text-sm">
        <th scope="col" class="py-3 pr-6 font-bold md:w-56 lg:w-64">{table.board}</th>
        <th scope="col" class="py-3 pr-6 font-bold">{table.goodFor}</th>
        <th scope="col" class="py-3 pr-6 font-bold md:w-48 lg:w-56">{table.kind}</th>
        <th scope="col" class="py-3 pr-6 font-bold md:w-36 lg:w-40">{table.access}</th>
        <th scope="col" class="py-3 font-bold md:w-48">{table.site}</th>
      </tr>
    </thead>
    <tbody>
      {
        content.rows.map((board) => (
          <tr
            id={boardSlug(board.name)}
            data-kind={board.category}
            data-access={board.access}
            data-text={foldText(`${board.name} ${board.note} ${category.get(board.category)?.label} ${table.accessLabels[board.access]} ${boardHost(board.url)}`)}
            class="relative transition-colors duration-150 hover:bg-grey target:bg-yellow/30 scroll-mt-24 lg:scroll-mt-72 max-md:grid max-md:grid-cols-1 max-md:gap-y-2 max-md:py-5"
          >
            <th scope="row" class="py-5 pr-6 align-top text-left max-md:p-0">
              <ExternalLink
                href={board.url}
                campaign={campaign}
                class="font-clash font-semibold text-lg md:text-xl underline-offset-4 decoration-2 hover:underline visited:text-black/60 after:absolute after:inset-0 focus-visible:outline-none focus-visible:after:outline focus-visible:after:outline-2 focus-visible:after:-outline-offset-2 focus-visible:after:outline-orange"
              >
                {board.name}
              </ExternalLink>
            </th>
            <td class="py-5 pr-6 align-top text-sm md:text-base leading-relaxed max-md:row-start-4 max-md:p-0">
              {board.note}
            </td>
            <td class="py-5 pr-6 align-top max-md:row-start-2 max-md:p-0">
              <span class="inline-flex items-baseline gap-2 text-sm text-black/70">
                <span
                  class:list={['w-2.5 h-2.5 rounded-full shrink-0 self-center md:self-auto md:translate-y-px', categoryDot[category.get(board.category)!.color]]}
                  aria-hidden="true"
                />
                {category.get(board.category)?.label}
              </span>
            </td>
            <td class="py-5 pr-6 align-top max-md:row-start-3 max-md:p-0">
              <span class="inline-flex items-center gap-1.5 text-sm text-black/70">
                <svg
                  viewBox="0 0 24 24"
                  class="w-3.5 h-3.5 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" />
                  <path d={accessIcon[board.access]} />
                </svg>
                {table.accessLabels[board.access]}
              </span>
            </td>
            <td class="py-5 align-top text-sm text-black/70 max-md:row-start-5 max-md:p-0 md:max-lg:min-w-32">
              {/* Below lg a long host may break anywhere (the tablet table has no room for it whole; min-w-32 keeps the column from
                   collapsing), and the arrow sits on its last line: h-5 is one text-sm line, so on one line it is centred as before. */}
              <span class="inline-flex items-end gap-1 max-lg:[overflow-wrap:anywhere]">
                {boardHost(board.url)}
                <span class="flex h-5 items-center [&>svg]:w-3.5 [&>svg]:h-3.5" aria-hidden="true">
                  <Icon name="arrow-up-right" />
                </span>
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <div class="py-16 text-center" hidden data-board-empty>
    <p class="text-base font-bold">{table.empty}</p>
    <button
      type="button"
      data-board-clear
      class="mt-4 text-sm underline underline-offset-4 decoration-2 hover:text-orange focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange"
    >
      {table.clear}
    </button>
  </div>

  {
    content.tools.length > 0 && (
      <p class="mt-8 text-sm md:text-base leading-relaxed text-black/80 max-w-3xl">
        <span class="font-bold">{content.toolsLabel}</span>{' '}
        {content.tools.map((tool, index) => (
          <>
            {index > 0 && ' '}
            <ExternalLink
              href={tool.url}
              campaign={campaign}
              class="font-clash font-semibold underline underline-offset-4 decoration-2 hover:text-orange visited:text-black/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange"
            >
              {tool.name}
            </ExternalLink>{' '}
            — {tool.note}
          </>
        ))}
      </p>
    )
  }
</section>

<style>
  tbody tr { border-bottom: 1px solid rgb(17 17 17 / 0.1); } /* taste-skill-ignore: rows of a real table */

  /* A hairline under the filters only while they are stuck over the table. */
  .toolbar {
    transition: box-shadow 200ms ease-out;
  }

  .toolbar[data-stuck] {
    box-shadow: 0 1px 0 rgb(17 17 17 / 0.1), 0 10px 18px -16px rgb(17 17 17 / 0.45); /* taste-skill-ignore: sticky toolbar, a real overlay */
  }

  /* Rows wait for the reveal in the motion script below. Opacity, not visibility: the row links stay
     focusable, so a keyboard user can tab into rows that have not scrolled in yet. */
  :global(.motion) [data-board-list] tbody tr {
    opacity: 0;
  }
</style>

<script>
  // Runs for the table in the page, once per navigation: this module is evaluated only once per full load, so a
  // second visit through the router is served by the astro:page-load listener below. data-bound: never bound twice.
  function setupBoardTable() {
    const root = document.querySelector<HTMLElement>('[data-board-table]');
    if (!root || root.hasAttribute('data-bound')) return;
    root.setAttribute('data-bound', '');

    const rows = [...root.querySelectorAll<HTMLTableRowElement>('tbody tr')];
    const pills = [...root.querySelectorAll<HTMLButtonElement>('[data-kind-filter]')];
    const accessPills = [...root.querySelectorAll<HTMLButtonElement>('[data-access-filter]')];
    const search = root.querySelector<HTMLInputElement>('[data-board-search]');
    const count = root.querySelector<HTMLElement>('[data-board-count]');
    const empty = root.querySelector<HTMLElement>('[data-board-empty]');
    const clear = root.querySelector<HTMLButtonElement>('[data-board-clear]');
    const toolbar = root.querySelector<HTMLElement>('[data-board-toolbar]');
    const sentinel = root.querySelector<HTMLElement>('[data-toolbar-sentinel]');
    const list = root.querySelector<HTMLElement>('[data-board-list]');
    const template = count?.dataset.template ?? '';
    let kind = 'all';
    let access = 'all';

    // Same folding as `foldText` on the server: lowercase, no accents, so
    // "teletravail" finds "télétravail". Words are loosely stemmed, so
    // "salary" also finds "salaries"; every word typed has to match.
    const fold = (text: string) =>
      text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const stem = (word: string) => word.replace(/(ies|es|s|y)$/, '');

    // Height of the sticky navbar once it is stuck (md and up).
    const NAVBAR = 101;
    const isSticky = () => !!toolbar && getComputedStyle(toolbar).position === 'sticky';

    // Filtering from deep in the table shrinks the page under the visitor;
    // bring the top of the results back to just under the stuck filters.
    // The target is absolute, so it holds even when the shorter page has
    // already pulled the filters up with it.
    const revealResults = () => {
      if (!toolbar || !list || !isSticky()) return;
      const offset = NAVBAR + toolbar.offsetHeight;
      const top = list.getBoundingClientRect().top;
      if (top < offset) window.scrollTo({ top: window.scrollY + top - offset });
    };

    const apply = () => {
      const terms = fold(search?.value ?? '').split(/\s+/).filter(Boolean).map(stem);
      const visible: HTMLTableRowElement[] = [];
      for (const row of rows) {
        const text = row.dataset.text ?? '';
        const match =
          (kind === 'all' || row.dataset.kind === kind) &&
          (access === 'all' || row.dataset.access === access) &&
          terms.every((term) => text.includes(term));
        // Inline style, not `hidden`: the rows are `display: grid` on small
        // screens, and a utility class outranks the [hidden] rule.
        row.style.display = match ? '' : 'none';
        if (match) visible.push(row);
      }
      const shown = visible.length;
      if (count) {
        count.textContent = template
          .replace('{shown}', String(shown))
          .replace('{total}', String(rows.length));
      }
      if (empty) empty.hidden = shown > 0;
      revealResults();
      root.dispatchEvent(new CustomEvent('board:filtered', { detail: visible }));
    };

    const select = (next: string) => {
      kind = next;
      pills.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.kindFilter === kind)));
      apply();
    };

    const selectAccess = (next: string) => {
      access = next;
      accessPills.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.accessFilter === access)));
      apply();
    };

    pills.forEach((p) => p.addEventListener('click', () => select(p.dataset.kindFilter ?? 'all')));
    accessPills.forEach((p) => p.addEventListener('click', () => selectAccess(p.dataset.accessFilter ?? 'all')));
    search?.addEventListener('input', apply);
    clear?.addEventListener('click', () => {
      if (search) search.value = '';
      selectAccess('all');
      select('all');
      search?.focus();
    });

    // Stuck = the toolbar is sticky (wide screens only) and the sentinel just
    // above it has scrolled up past the navbar's bottom edge.
    if (toolbar && sentinel) {
      new IntersectionObserver(
        ([entry]) => {
          const above = !entry.isIntersecting && entry.boundingClientRect.top <= NAVBAR;
          toolbar.toggleAttribute('data-stuck', isSticky() && above);
        },
        { rootMargin: `-${NAVBAR}px 0px 0px 0px` }
      ).observe(sentinel);
    }
  }

  // The direct call is the first visit (this module runs as the page arrives); the listener serves every later one,
  // and a browser without the router never fires it (BaseLayout: fallback="none").
  setupBoardTable();
  document.addEventListener('astro:page-load', setupBoardTable);
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ease, onPage, withIntro } from '../../scripts/motion/engine';

  // Rows scroll in as a batch; a filter rises only the rows it newly shows. Every tween has explicit ends and
  // clears its transform, so a row hidden by a filter and shown again never keeps a stale state.
  onPage(({ signal }) => {
    const root = document.querySelector<HTMLElement>('[data-board-table]');
    const rows = root ? [...root.querySelectorAll<HTMLElement>('tbody tr')] : [];
    if (!root || !rows.length) return;

    const rise = (targets: gsap.TweenTarget, y: number, vars: gsap.TweenVars) =>
      gsap.fromTo(targets, { y, opacity: 0 }, { y: 0, opacity: 1, clearProps: 'transform', ...vars });

    // A row rises the moment any of it is on screen, so no visible row is still hidden. After a page change that is
    // behind the curtain: the first batch waits for the page intro, which starts as the curtain clears. A row that
    // focus or a filter showed in the meantime (inline opacity) is left alone.
    const waiting = ScrollTrigger.batch(rows, {
      start: 'top bottom',
      once: true,
      onEnter: (batch) =>
        withIntro(() => {
          const todo = batch.filter((row) => (row as HTMLElement).style.opacity === '');
          if (todo.length) rise(todo, 24, { duration: 0.9, stagger: 0.04, ease: ease.out });
        }),
    });

    // Tab can still reach a row ahead of its trigger, and its ring would be invisible: show it at once.
    // A tween leaves opacity 1 inline when it ends, so that marks a row as done.
    root.addEventListener(
      'focusin',
      (event) => {
        const row = (event.target as Element).closest<HTMLElement>('tbody tr');
        if (!row || row.style.opacity === '1') return;
        waiting[rows.indexOf(row)]?.kill();
        gsap.killTweensOf(row);
        gsap.set(row, { y: 0, opacity: 1, clearProps: 'transform' });
      },
      { capture: true, signal },
    );

    let shown = rows;
    let refresh: gsap.core.Tween | undefined;
    root.addEventListener(
      'board:filtered',
      (event) => {
        const next = (event as CustomEvent<HTMLElement[]>).detail;
        if (next.length === shown.length && next.every((row, i) => row === shown[i])) return;
        // Only rows the list did not show before rise, plus any that never played (no inline opacity yet): typing
        // must not re-fade the rows that stay.
        const fresh = next.filter((row) => !shown.includes(row) || row.style.opacity === '');
        shown = next;
        waiting.forEach((trigger) => trigger.kill()); // the list was just reshaped: show it now, not on scroll
        // The page got shorter or taller: the sections below must re-measure, once typing pauses.
        refresh?.kill();
        refresh = gsap.delayedCall(0.15, () => ScrollTrigger.refresh());
        if (fresh.length) rise(fresh, 12, { duration: 0.4, stagger: 0.02, ease: ease.soft, overwrite: true });
      },
      { signal },
    );

    return () => {
      gsap.killTweensOf(rows);
      refresh?.kill();
    };
  });
</script>

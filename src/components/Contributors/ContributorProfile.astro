---
import { Image } from 'astro:assets';
import { getLangFromPath, routes } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import {
  avatarColorClass,
  contributorInitials,
  contributorName,
  formatContributionMonth,
  type Contributor,
} from './contributors';

interface Props {
  contributor: Contributor;
}

const { contributor } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
const strings = t(lang).contributors;
const name = contributorName(contributor);
const role = contributor.data.role[lang];
const month = formatContributionMonth(contributor.data.lastContribution, lang);

// A blank line in the YAML starts a new paragraph.
const paragraphs = contributor.data.contributions[lang]
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// The "About" summary is one short block, not a paragraph list.
const about = contributor.data.about?.[lang]?.trim();
const aboutParagraphs = about
  ? about.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean)
  : [];

const socials = (
  Object.entries(contributor.data.socials ?? {}) as [
    keyof typeof strings.socialLabels,
    string,
  ][]
).filter(([, url]) => Boolean(url));

// Structured fact rows shown under the name. Order matters for scannability.
const factRows: { label: string; value: string }[] = [];
if (contributor.data.currentSituation) {
  factRows.push({
    label: strings.currentSituationLabel,
    value: contributor.data.currentSituation[lang],
  });
}
factRows.push({ label: strings.lastContributionLabel, value: month });
---

<div class="font-inter text-white bg-black-light mx-4 md:mx-8 my-10 rounded-3xl">
  <main id="main-content" class="max-w-screen-2xl mx-auto px-4 py-16 md:py-24">
    <div class="max-w-screen-lg mx-auto">
      <a
        href={routes.contributors[lang]}
        class="inline-flex items-center gap-2 text-sm font-bold text-ashgray transition-colors duration-200 hover:text-orange focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          fill="none"
          class="h-3.5 w-3.5"
        >
          <path
            d="M10 3 5 8l5 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        {strings.backToContributors}
      </a>

      <div class="mt-10 md:mt-14 md:flex md:items-start md:gap-12 lg:gap-16">
        <div class="w-40 shrink-0 md:w-64">
          {
            contributor.data.avatar ? (
              <Image
                src={contributor.data.avatar}
                alt=""
                width={512}
                height={512}
                class:list={[
                  'aspect-square w-full rounded-xl object-cover',
                  avatarColorClass(contributor.data.avatarColor),
                ]}
              />
            ) : (
              <div
                aria-hidden="true"
                class="flex aspect-square w-full items-center justify-center rounded-xl bg-purple/15 font-clash font-bold text-5xl md:text-7xl text-purple"
              >
                {contributorInitials(contributor)}
              </div>
            )
          }
        </div>

        <div class="mt-8 md:mt-0">
          <h1 class="font-clash font-bold text-4xl md:text-5xl leading-tight">
            {name}
          </h1>
          <p class="mt-3 text-sm font-bold uppercase tracking-wide text-purple">
            {role}
          </p>

          <dl class="mt-6 divide-y divide-white/10 overflow-hidden rounded-xl border border-white/10">
            {
              factRows.map((row) => (
                <div class="flex items-baseline gap-3 bg-white/5 px-4 py-3">
                  <dt class="w-32 shrink-0 text-xs font-bold uppercase tracking-wide text-purple">
                    {row.label}
                  </dt>
                  <dd class="text-sm md:text-base font-medium text-grey">
                    {row.value}
                  </dd>
                </div>
              ))
            }
          </dl>

          {
            aboutParagraphs.length > 0 && (
              <section class="mt-10">
                <h2 class="font-clash font-bold text-2xl md:text-3xl">
                  {strings.aboutLabel}
                </h2>
                <div class="max-w-prose">
                  {aboutParagraphs.map((paragraph) => (
                    <p class="mt-4 text-sm md:text-base leading-relaxed text-ashgray">
                      {paragraph}
                    </p>
                  ))}
                </div>
              </section>
            )
          }

          <h2 class="mt-10 font-clash font-bold text-2xl md:text-3xl">
            {strings.contributionsTitle(contributor.data.firstName)}
          </h2>
          <div class="max-w-prose">
            {
              paragraphs.map((paragraph) => (
                <p class="mt-4 text-sm md:text-base leading-relaxed text-ashgray">
                  {paragraph}
                </p>
              ))
            }
          </div>

          {
            socials.length > 0 && (
              <>
                <h2 class="mt-12 font-clash font-bold text-2xl md:text-3xl">
                  {strings.socialsTitle}
                </h2>
                <ul class="mt-5 flex flex-wrap gap-3">
                  {socials.map(([network, url]) => (
                    <li>
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-2 rounded-full border-2 border-orange px-4 py-1.5 text-sm font-bold text-grey transition-colors duration-200 hover:bg-orange hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange"
                      >
                        {strings.socialLabels[network]}
                        <svg
                          aria-hidden="true"
                          viewBox="0 0 16 16"
                          fill="none"
                          class="h-3.5 w-3.5"
                        >
                          <path
                            d="M4 12 12 4M6 4h6v6"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </div>
    </div>
  </main>
</div>

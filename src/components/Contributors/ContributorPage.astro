---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContributorProfile from './ContributorProfile.astro';
import { SITE, absoluteUrl, contributorPath, getLangFromPath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { contributorName, type Contributor } from './contributors';

interface Props {
  contributor: Contributor;
}

const { contributor } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
const strings = t(lang).contributors;
const name = contributorName(contributor);
const role = contributor.data.role[lang];
const socialUrls = Object.values(contributor.data.socials ?? {}).filter(Boolean);

// One Person node per profile page; slots into BaseLayout's head slot.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name,
    description: role,
    url: absoluteUrl(contributorPath(lang, contributor.id)),
    ...(contributor.data.avatar && { image: `${SITE}${contributor.data.avatar.src}` }),
    ...(socialUrls.length > 0 && { sameAs: socialUrls }),
  },
};
---

<BaseLayout
  metaKey="contributors"
  title={`${name} | GoodEWorkers`}
  description={strings.profileMetaDescription(name, role)}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <ContributorProfile contributor={contributor} />
</BaseLayout>

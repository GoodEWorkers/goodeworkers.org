---
import ContactForm from './ContactForm.astro';

const currentYear = new Date().getFullYear();
const goodEWorkersEmail = 'hello@goodeworkers.org';
const goodEWorkersText1 = 'hello';
const goodEWorkersText2 = '@goodeworkers.org';
const goodEWorkersText3 = `GoodEWorkers © ${currentYear}`;
const goodEWorkersText4 = 'Legal Notice | Mentions légales';
const githubUrl = 'https://github.com/GoodEWorkers';

// "Contact-us !" was a calque of "Contactez-nous" carrying French punctuation
// spacing into English, set in 12px type as a <p> — so the conversion section
// had the smallest text on the page and no heading at all, while every other
// section has an H2.
const contactHeading = 'Tell us about your project';
---

<footer class="relative z-10 bg-white text-black font-inter">
  <div
    class="absolute -z-50 bg-transparent w-px h-px transform -translate-y-12"
    id="contact"
  >
  </div>
  <div class="max-w-screen-2xl mx-auto px-4 md:px-8 mb-4 pt-12 pb-10">
    <div class="flex flex-col">
      <h2 class="text-2xl sm:text-3xl font-clash font-bold">
        {contactHeading}
      </h2>
      <div class="mt-4">
        <a
          href={`mailto:${goodEWorkersEmail}?subject=Project%20enquiry`}
          class="text-3xl font-bold hover:underline"
        >
          {goodEWorkersText1}<br />{goodEWorkersText2}
        </a>
      </div>
      <ContactForm />
    </div>
    <ul
      class="mt-24 md:mt-40 xl:mt-60 flex flex-col items-center text-sm space-y-2"
    >
      <li class="hover:underline">
        <!-- Trailing slash: /legal-notice 301s to /legal-notice/, so linking the
             un-slashed form spent a redirect on every internal click. -->
        <a href="/legal-notice/">{goodEWorkersText4}</a>
      </li>
      <li>
        <!-- "Open source" is claimed repeatedly across the site; this is the
             first link that lets anyone verify it. -->
        Our work is open source on <a
          class="hover:underline"
          href={githubUrl}
          rel="noopener">GitHub</a
        >
      </li>
      <li>
        This site is powered by <a
          class="hover:underline"
          href="https://netlify.com?utm_source=goodeworkers">Netlify</a>
      </li>
      <li>{goodEWorkersText3}</li>
    </ul>
  </div>
</footer>

---
import ContactForm from './ContactForm.astro';
import ExternalLink from './ExternalLink.astro';
import { getLangFromPath, languages, routes } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  /** Per-page contact heading and mail subject, for pages whose visitors
   *  are not bringing a project (the job boards page invites them to join). */
  contact?: { title: string; mailSubject: string };
}

const lang = getLangFromPath(Astro.url.pathname);
const { footer } = t(lang);
const contact = Astro.props.contact ?? {
  title: footer.contactTitle,
  mailSubject: footer.mailSubject,
};

const currentYear = new Date().getFullYear();
const goodEWorkersEmail = 'hello@goodeworkers.org';
const emailLocalPart = 'hello';
const emailDomainPart = '@goodeworkers.org';
const githubUrl = 'https://github.com/GoodEWorkers';
---

<footer class="relative z-10 font-inter">
  <div
    class="absolute -z-50 bg-transparent w-px h-px transform -translate-y-12"
    id="contact"
  >
  </div>
  {/* The contact sheet: the hero's rounded paper again, on the column box, so it ends where the hero sheet does. */}
  <div
    class="max-w-screen-2xl mx-auto px-4 md:px-8 pt-12 pb-10 bg-white text-black rounded-xl sm:rounded-2xl lg:rounded-3xl"
  >
    <div class="flex flex-col">
      <h2 class="text-3xl sm:text-4xl font-clash font-bold" data-title>
        {contact.title}
      </h2>
      <div class="mt-6">
        <a
          href={`mailto:${goodEWorkersEmail}?subject=${encodeURIComponent(contact.mailSubject)}`}
          class="text-3xl min-[360px]:text-4xl sm:text-5xl font-bold leading-[1.1] hover:underline focus-visible:underline"
        >
          <span data-roll>{emailLocalPart}</span><br /><span data-roll>{emailDomainPart}</span>
        </a>
      </div>
      <ContactForm />
    </div>
    <ul
      class="mt-24 md:mt-40 xl:mt-60 flex flex-col items-center text-sm space-y-2"
    >
      <li class="hover:underline has-[:focus-visible]:underline">
        <a href={routes.values[lang]} hreflang={languages[lang].htmlLang}>
          {footer.valuesLink}
        </a>
      </li>
      <li class="hover:underline has-[:focus-visible]:underline">
        <a href={routes.initiatives[lang]} hreflang={languages[lang].htmlLang}>
          {footer.initiativesLink}
        </a>
      </li>
      <li class="hover:underline has-[:focus-visible]:underline">
        <a href={routes.jobBoards[lang]} hreflang={languages[lang].htmlLang}>
          {footer.jobBoardsLink}
        </a>
      </li>
      <li class="hover:underline has-[:focus-visible]:underline">
        <a href={routes.legal[lang]} hreflang={languages[lang].htmlLang}>
          {footer.legalLink}
        </a>
      </li>
      <li>
        <!-- "Open source" is claimed repeatedly across the site; this is the
             first link that lets anyone verify it. -->
        {footer.openSource} <ExternalLink class="hover:underline focus-visible:underline" href={githubUrl}
          >GitHub</ExternalLink
        >
      </li>
      <li>
        {footer.poweredBy} <ExternalLink class="hover:underline focus-visible:underline" href="https://www.netlify.com/"
          >Netlify</ExternalLink
        >
      </li>
      <li>{footer.copyright(currentYear)}</li>
    </ul>
  </div>
  {/* The closing band: the H1's wordmark, as wide as the column allows. The word is 7.3em wide, so 11vw leaves it a
      fifth of the screen spare; the 2rem floor only matters below 290px (a 3rem floor overflows under 380px). Decorative,
      so it is hidden from assistive tech: the name is in the copyright line above. */}
  <div class="max-w-screen-2xl mx-auto px-4 md:px-8 pt-12 pb-8 lg:pt-20 lg:pb-12" aria-hidden="true">
    <div
      class="text-center font-clash leading-[0.9] tracking-[-0.02em] text-nowrap text-[clamp(2rem,11vw,12rem)]"
      data-split="chars"
    >
      <span class="text-yellow font-medium">Good</span><span class="text-orange font-semibold">e</span><span class="text-purple font-medium">Workers</span>
    </div>
  </div>
</footer>

<style is:global>
  /* The address is big and tight (line-height 1.1): the roll's clip needs room below it for the g and the @. */
  a[href^='mailto:'] [data-roll-clip] {
    padding-bottom: 0.15em;
    margin-bottom: -0.15em;
  }
</style>

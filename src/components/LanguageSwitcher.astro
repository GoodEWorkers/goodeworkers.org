---
import { getAlternatePaths, getLangFromPath, langCodes, languages } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  /** `nav` for the desktop bar, `menu` for the full-screen mobile panel. */
  variant?: 'nav' | 'menu';
  class?: string;
}

const { variant = 'nav', class: className = '' } = Astro.props;

const lang = getLangFromPath(Astro.url.pathname);
const strings = t(lang);
// Each language points at the *same page* in that language, never at the
// homepage — a switcher that dumps everyone on / loses the crawler's page pair.
const alternates = getAlternatePaths(Astro.url.pathname);

const sizing = variant === 'menu' ? 'text-xl' : 'text-sm';
const gap = variant === 'menu' ? 'gap-6' : 'gap-4';
---

<nav
  class:list={['flex items-center', className]}
  aria-label={strings.langSwitch.label}
>
  <ul class:list={['flex items-center', gap]}>
    {
      langCodes.map((code) => {
        const isCurrent = code === lang;
        return (
          <li>
            <a
              href={alternates[code]}
              hreflang={languages[code].htmlLang}
              lang={languages[code].htmlLang}
              aria-current={isCurrent ? 'true' : undefined}
              title={isCurrent ? languages[code].label : `${strings.langSwitch.switchTo} ${languages[code].label}`}
              class:list={[
                'block font-bold pb-1 border-b-2 transition-colors duration-200',
                sizing,
                isCurrent
                  ? 'text-yellow border-yellow'
                  : 'text-grey/50 border-transparent hover:text-grey',
              ]}
            >
              <span aria-hidden="true">{languages[code].short}</span>
              <span class="sr-only">{languages[code].label}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

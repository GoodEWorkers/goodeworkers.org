---
import { getCollection } from 'astro:content';
import Icon from '../icons/Icon.astro';
import ArticleCard from '../Articles/ArticleCard.astro';

interface Props {
  heading?: string;
  excludeSlug?: string;
  limit?: number;
}

const {
  heading = 'Latest articles',
  excludeSlug,
  limit = 3,
} = Astro.props;

const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
)
  .filter((a) => a.slug !== excludeSlug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, limit);
---

{articles.length > 0 && (
  <section
    id="latest-articles"
    class="sheet bg-black-light text-grey py-12 md:py-16 mb-20 xl:mb-32"
  >
    <div
      class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between"
    >
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-clash font-medium" data-split="lines">
        {heading}
      </h2>
      <a
        href="/articles/"
        data-reveal="up"
        data-delay="0.15"
        class="inline-flex items-center gap-2 min-h-11 font-bold underline decoration-2 underline-offset-4 hover:text-orange focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange [&_svg]:h-4 [&_svg]:w-4 [&_svg]:transition-transform [&_svg]:hover:translate-x-1 [&_svg]:focus-visible:translate-x-1"
      >
        See all our articles
        <Icon name="arrow-right" />
      </a>
    </div>
    <ul class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12 md:gap-x-8" data-stagger>
      {articles.map((article) => <li><ArticleCard article={article} /></li>)}
    </ul>
  </section>
)}

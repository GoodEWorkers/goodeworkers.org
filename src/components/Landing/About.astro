---
import { Image } from 'astro:assets';
import Alice from '../../assets/images/alice_thumb.png';
import Richard from '../../assets/images/richard_thumb.png';
import BigRoundedLinkBtn from '../Common/BigRoundedLinkBtn.astro';
import { contactAnchor, getLangFromPath } from '../../i18n/routes';
import { homeContent } from '../../i18n/home';

const lang = getLangFromPath(Astro.url.pathname);
const { about } = await homeContent(lang);
---

<section id="who-are-we">
  <div
    class="bg-black-light rounded-xl lg:rounded-2xl text-grey font-medium text-sm md:text-base pt-10 px-6 md:px-8 mb-36 sm:mb-56 lg:mb-20 xl:mb-28"
  >
    <div
      class="lg:flex lg:items-center lg:space-x-8 xl:space-x-16 lg:justify-between max-w-screen-2xl mx-auto"
    >
      <div class="flex flex-col max-w-screen-md lg:py-16">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl lg:text-4xl xl:text-5xl 2xl:text-[54px] font-medium leading-[1.2] md:leading-tight lg:leading-tight"
        >
          {about.titlePart1}
          <span class="font-bold">{about.titleBold}</span>
          {about.titlePart2}
        </h2>
        <p class="mt-7 sm:mt-10 md:mt-14 lg:mt-10">
          {about.intro}
          <span class="font-bold">{about.introBold}</span>
        </p>
        <p class="mt-4">{about.text2}</p>
        <p class="mt-4">{about.text3}</p>
        <h3 class="mt-8 font-bold text-purple uppercase">{about.benefitsTitle}</h3>
        <ul class="mt-8 space-y-6 leading-loose list-disc pl-5">
          {about.benefits.map((benefit) => <li>{benefit}</li>)}
          <li>
            {about.benefitOpenSource}{' '}
            <a
              href="https://github.com/GoodEWorkers"
              class="underline hover:text-orange"
              rel="noopener">{about.githubCta}</a
            >.
          </li>
        </ul>
      </div>
      <div>
        <BigRoundedLinkBtn
          bigBtmText={about.cta}
          href={contactAnchor(lang, 'joinus-mobile')}
          class="lg:hidden bg-orange text-white-pure mt-10 mx-auto"
        />
        <div
          class="relative mt-6 sm:mt-16 lg:mt-0 h-72 sm:h-80 lg:h-72 w-full flex justify-center items-center"
        >
          <div class="w-40 sm:w-56 flex-shrink-0 translate-x-3 sm:translate-x-5 relative">
            <Image
              src={Richard}
              alt=""
              width={240}
              height={240}
              class="rounded-xl w-full aspect-square"
            />
            <p class="text-xs sm:text-sm absolute -bottom-6 left-0">
              Richard, <span class="font-semibold">{about.roleFounder}</span>
            </p>
          </div>
          <div
            class="w-40 sm:w-56 flex-shrink-0 -translate-x-3 sm:-translate-x-5 translate-y-32 sm:translate-y-44 relative"
          >
            <Image
              src={Alice}
              alt=""
              width={240}
              height={240}
              class="rounded-xl w-full aspect-square"
            />
            <p class="text-xs sm:text-sm -bottom-6 absolute left-0">
              Alice, <span class="font-semibold">{about.roleDirector}</span>
            </p>
          </div>
        </div>
        <div class="hidden lg:block xl:relative xl:-left-56">
          <BigRoundedLinkBtn
            bigBtmText={about.cta}
            href={contactAnchor(lang, 'joinus-desktop')}
            class="bg-orange text-white-pure mt-56 xl:mt-16 mx-auto"
          />
        </div>
      </div>
    </div>
  </div>
</section>

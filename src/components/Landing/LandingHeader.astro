---
import Encircled from '../Miscs/Encircled.astro';
import { getLangFromPath } from '../../i18n/routes';
import { homeContent } from '../../i18n/home';

const { header } = await homeContent(getLangFromPath(Astro.url.pathname));
---

<header class="pt-8 md:pt-12 lg:pt-24 text-grey">
  <!--
    Both lines of the H1 share one line-height. The second line used to be an
    `inline-block` carrying `mt-4 md:mt-8 lg:mt-12`, which stacked a 48px margin
    on top of the line box and pushed the two lines ~1.7x apart — issue #45.
  -->
  <h1
    class="text-4xl/tight md:text-5xl/tight lg:text-7xl/tight xl:text-[74px]/[83px] text-center"
    data-intro="title"
  >
    <span class="text-yellow font-clash font-medium">Good</span><span class="text-orange font-clash font-semibold">e</span><span class="text-purple font-clash font-medium">Workers</span>
    <br />
    <span class="font-medium">{header.titlePart1}</span> <Encircled text={header.titleEncircled} class="font-bold" /> <span class="font-medium">{header.titlePart2}</span>
  </h1>
  <p
    class="mt-8 md:mt-12 lg:mt-16 px-4 sm:px-16 max-w-screen-md mx-auto text-base text-center leading-[1.6875]"
    data-intro="lede"
  >
    {header.intro}
  </p>
  <p
    class="mt-4 px-4 sm:px-16 max-w-screen-md mx-auto text-base font-bold text-center leading-[1.6875]"
    data-intro="lede"
  >
    {header.introBold}
  </p>
</header>

<style is:global>
  /* Home-only motion CSS for src/scripts/motion/home.ts. Every rule is gated on html.motion like the engine's own,
     so without JS, under reduced motion, or once the failsafe drops html.motion, everything is simply there. */

  /* Hidden until home.ts builds the intro and the 3D titles. By opacity, not visibility: the pills (and any link) stay
     reachable with Tab. The words and the ring are the parts of a title that arrive last; the nav is the last of the intro. */
  .motion [data-intro],
  .motion [data-title],
  .motion [data-title] div,
  .motion [data-title] span.relative > span:last-child:empty,
  .motion [data-navbar] {
    opacity: 0;
  }
  /* A title's words swing in from the side: until they land (home.ts lifts this) the heading clips them
     instead of widening the page. */
  .motion [data-title] {
    overflow-x: clip;
  }
  /* Split into inline-block words, a title can break its line between a circled word and the joiner after it (see
     Encircled.astro) and strand the ring on a zero-width fragment: a bar instead of a circle. Circled words are single
     words, so this only keeps the ring with its word. */
  .motion [data-title] .encircled {
    white-space: nowrap;
  }
  /* The hero sheet starts as a closed window, so the first paint is not the open sheet snapping shut once the script
     runs. These are the insets heroWindow() starts from: capped where the sheet's content starts (about 5rem from the top
     below 1024px, 2rem from the sides from 1024px), so the window only ever trims padding. From 1280px the hero's row has
     6rem of padding of its own: the sides are 6rem, which keeps 2rem clear of the content. */
  .motion [data-window] {
    clip-path: inset(min(14%, 5rem) 6% 10% 6% round 40px);
  }
  @media (min-width: 1024px) {
    .motion [data-window] {
      clip-path: inset(14% min(6%, 2rem) 10% min(6%, 2rem) round 40px);
    }
  }
  @media (min-width: 1280px) {
    .motion [data-window] {
      clip-path: inset(14% 6rem 10% 6rem round 40px);
    }
  }
  @media (max-width: 639px) {
    .motion [data-window] {
      clip-path: inset(6% 6% 4% 6% round 24px);
    }
  }
</style>

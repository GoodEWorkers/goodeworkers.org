---
import CircledText from '../JobBoards/CircledText.astro';
import Icon from '../icons/Icon.astro';
import BigRoundedLinkBtn from '../Common/BigRoundedLinkBtn.astro';
import { typeset } from '../Common/typeset';
import { valueStyles } from '../Values/valueStyles';
import { getLangFromPath, routes } from '../../i18n/routes';
import { homeContent } from '../../i18n/home';

const lang = getLangFromPath(Astro.url.pathname);
const { values } = await homeContent(lang);
const t = (text: string) => typeset(text, lang);

const pairs = [
  { label: values.groups.work, items: values.items.slice(0, 2) },
  { label: values.groups.care, items: values.items.slice(2) },
];
---

<!-- The four values, short, on a dark card between the night-ground Why section and the About card. Like every surface it
     is a `.sheet`, so it has the column's width and the About card's edges. The full text is
     on the values page. From xl the card is two columns: the statement and the way on at the left, the four values as a
     two by two register at the right (so no corner of the card is left empty). -->
<section
  id="values"
  aria-labelledby="values-title"
  class="sheet pt-12 md:pt-16 pb-12 md:pb-16 mb-16 md:mb-24 bg-black-light text-grey xl:grid xl:grid-cols-12 xl:gap-x-8 xl:gap-y-10"
  data-reveal="up"
>
  <div class="xl:col-span-5 xl:col-start-1 xl:row-start-1">
    <h2
      id="values-title"
      class="text-3xl sm:text-4xl md:text-5xl xl:text-[54px] font-medium leading-[1.2] md:leading-tight"
      data-title
    >
      <CircledText text={values.title} />
    </h2>
    <p class="mt-6 max-w-[26rem] text-base md:text-lg font-bold leading-snug text-balance" data-reveal="up" data-delay="0.1">{t(values.lead)}</p>
  </div>

  <!-- The two pairs, as on the values page. Each name is in its value's colour, in the face of the tiles. -->
  <div class="mt-14 xl:mt-0 xl:col-span-7 xl:col-start-6 xl:row-span-2 xl:row-start-1 space-y-[5.5rem] sm:space-y-16 xl:space-y-14">
    {
      pairs.map((pair) => (
        <div>
          <p class="text-xl md:text-2xl font-medium leading-tight text-balance">{t(pair.label)}</p>
          <ul class="mt-6 grid sm:grid-cols-2 gap-x-8 gap-y-9" data-stagger>
            {pair.items.map((item) => {
              const style = valueStyles[item.id];
              return (
                <li class="group relative">
                  <h3>
                    <a
                      href={`${routes.values[lang]}#${item.id}`}
                      style={`color: ${style.ink}`}
                      class="font-clash font-semibold text-4xl xl:text-[40px] leading-none pb-1 outline-none after:absolute after:inset-0 after:rounded-2xl focus-visible:after:outline focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-orange [background-image:linear-gradient(currentColor,currentColor)] bg-no-repeat bg-left-bottom bg-[length:0%_2px] transition-[background-size] duration-500 ease-out group-hover:bg-[length:100%_2px] focus-visible:bg-[length:100%_2px]"
                    >
                      {item.name}
                    </a>
                  </h3>
                  <p class="mt-3 text-base leading-[1.6875] text-ashgray text-pretty">{t(item.text)}</p>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mt-14 xl:mt-0 xl:col-span-5 xl:col-start-1 xl:row-start-2 xl:self-end flex flex-wrap items-center gap-x-8 gap-y-2">
    <BigRoundedLinkBtn
      upperSmallText={values.ctaSmall}
      bigBtmText={values.cta}
      href={routes.values[lang]}
      class="bg-orange text-black sm:w-fit sm:max-w-none sm:px-12"
    />
    <a
      href={routes.initiatives[lang]}
      class="inline-flex items-center gap-2 min-h-11 font-bold underline decoration-2 underline-offset-4 hover:text-orange focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange [&_svg]:h-4 [&_svg]:w-4 [&_svg]:transition-transform [&_svg]:hover:translate-x-1 [&_svg]:focus-visible:translate-x-1"
    >
      {values.initiativesCta}
      <Icon name="arrow-right" />
    </a>
  </div>
</section>

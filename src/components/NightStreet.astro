---
// The night street behind the footer wordmark: a seeded skyline drawn once at build time. The seed is the page path, so every page
// has its own street and it never changes between visits. Drawn in a 1600 x 220 box that `slice` crops to the band, bottom-aligned.
// Two layers: pen outlines (one path per building: walls, roof, rooftop detail and the frame of every window) and one light per
// window (an opacity-0 rect when dark), so street.ts can switch any window on without adding an element. At most 208 elements.
// The lights sit in a group at 70% and street.ts caps their flicker at 80%: the brightest window is 56%, which stays dimmer than
// the wordmark's orange even over the lamp's glow.
import { jitter, noise1, pick, polylineD, rndtri, seedFrom, smoothD, type Pt } from '../lib/gen';

const [W, H, FLOOR] = [1600, 220, 18]; // a floor is a 14 high window and 4 of wall
const seed = Astro.url.pathname;
const rand = seedFrom(seed);
const skyline = noise1(rand); // the rise and fall of the roofs along x
const lines = (list: Pt[][]) => list.map((pts) => polylineD(jitter(pts, rand, 0.4))).join('');

const buildings: string[] = []; // pen path of each
let cand: { b: number; x: number; y: number; k: number; v: number; o: number }[] = []; // window candidates

for (let x = 0; x < W; ) {
  const b = buildings.length;
  const w = Math.round(rndtri(rand, 60, 100, 180));
  const floors = Math.round(Math.min(9, Math.max(3, 6 + 3 * skyline((x + w / 2) / 300) + (rand() - 0.5) * 2)));
  const cols = w > 150 ? 4 : w > 100 ? 3 : 2;
  const top = H - floors * FLOOR - 6;
  const mid = (H + top) / 2;
  let d = polylineD(jitter([[x, H], [x, mid], [x, top], [x + w / 2, top], [x + w, top], [x + w, mid], [x + w, H]], rand, 0.6));

  // About two roofs in five carry a detail, clear of the corners.
  const at = x + 14 + rand() * (w - 28);
  const detail = rand() < 0.4 ? pick(rand, ['tank', 'antenna', 'chimney']) : '';
  if (detail === 'antenna') {
    const h = 16 + rand() * 14;
    d += lines([[[at, top], [at, top - h]], [[at - 4, top - h + 5], [at + 4, top - h + 5]], [[at - 3, top - h + 10], [at + 3, top - h + 10]]]);
  } else if (detail === 'chimney') {
    d += lines([[[at - 4, top], [at - 4, top - 11], [at + 4, top - 11], [at + 4, top]]]);
  } else if (detail === 'tank') {
    d += lines([[[at - 6, top], [at - 6, top - 5]], [[at + 6, top], [at + 6, top - 5]], [[at - 8, top - 5], [at + 8, top - 5]]]);
    d += smoothD(jitter([[at - 8, top - 5], [at - 8, top - 14], [at, top - 19], [at + 8, top - 14], [at + 8, top - 5]], rand, 0.3));
  }
  buildings.push(d);

  // Windows sit on a grid, 2 to 4 a floor. Each has its own seed: k ranks it for the empty slots and the budget, v for the lit
  // ones, o is its light level.
  for (let f = 0; f < floors; f++) {
    for (let c = 0; c < cols; c++) {
      const own = seedFrom(`${seed}:${b}:${f}:${c}`);
      const wx = Math.round(x + ((c + 0.5) * w) / cols - 5);
      const k = own();
      if (k < 0.92 && wx > 0 && wx < W - 10) cand.push({ b, x: wx, y: H - (f + 1) * FLOOR + 2, k, v: own(), o: own() });
    }
  }
  x += w + Math.round(rndtri(rand, 4, 8, 18));
}

// Over budget: the windows with the highest k go.
const room = 205 - buildings.length;
if (cand.length > room) {
  const cut = cand.map((win) => win.k).sort((a, b) => a - b)[room];
  cand = cand.filter((win) => win.k < cut);
}

// 12 to 18% of the windows are lit (the lowest v), one or two of them orange.
const lit = new Set([...cand.keys()].sort((a, b) => cand[a].v - cand[b].v).slice(0, Math.round(cand.length * (0.12 + rand() * 0.06))));
const orange = new Set([pick(rand, [...lit]), pick(rand, [...lit])]);

const pen = buildings.map((d, b) => d + cand.filter((win) => win.b === b).map((win) => `M${win.x} ${win.y}h10v14h-10z`).join(''));
const html =
  `<g fill="none" stroke="#E0E0E0" stroke-opacity=".18">${pen.map((d) => `<path d="${d}" vector-effect="non-scaling-stroke"/>`).join('')}</g>` +
  `<g fill="#FDC959" opacity=".7">${cand
    .map((win, i) => `<rect x="${win.x}" y="${win.y}" width="10" height="14"${orange.has(i) ? ' fill="#FD5E09"' : ''} opacity="${lit.has(i) ? +(0.55 + 0.15 * win.o).toFixed(2) : 0}"/>`)
    .join('')}</g>`;
---

<svg
  class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
  data-street
  set:html={html}
/>

---
// A line of copy where **double asterisks** mark bold words. Content files
// use it for the odd emphasised phrase; anything richer belongs in markdown.
interface Props {
  text: string;
}

const parts = Astro.props.text.split('**');
---

{parts.map((part, index) => (index % 2 === 1 ? <strong class="font-bold">{part}</strong> : part))}

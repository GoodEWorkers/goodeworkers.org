---
import ExternalLink from '../ExternalLink.astro';
import { getLangFromPath } from '../../i18n/routes';
import { valueStyles } from './valueStyles';
import type { ValuesContent } from '../../i18n/pages';

interface Props {
  content: ValuesContent;
}

const { content } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
// The page's own copy file, where a change to these values would be made.
const sourceUrl = `https://github.com/GoodEWorkers/goodeworkers.org/blob/main/src/content/values/${lang}.md`;

const groups = [
  { id: 'how-we-work', title: content.groups.work, values: content.values.slice(0, 2) },
  { id: 'whom-we-care-for', title: content.groups.care, values: content.values.slice(2) },
];
---

<!-- Each value as one row on the night ground. Its name carries the colour
     and face of its tile above. -->
<div class="mt-20 md:mt-28 space-y-16 md:space-y-24 text-grey">
  {
    groups.map((group) => (
      <section aria-labelledby={group.id}>
        <h2
          id={group.id}
          class="text-3xl sm:text-4xl md:text-5xl xl:text-[54px] font-medium leading-[1.2] md:leading-tight"
          data-split="lines"
        >
          {group.title}
        </h2>
        <div class="mt-8 md:mt-12">
          {group.values.map((value) => {
            const style = valueStyles[value.id];
            return (
              <article
                id={value.id}
                aria-labelledby={`${value.id}-title`}
                data-reveal="up"
                class="grid lg:grid-cols-12 lg:gap-x-8 py-10 md:py-14 scroll-mt-24 lg:scroll-mt-32 target:bg-black-light"
              >
                <div class="lg:col-span-4">
                  <h3
                    id={`${value.id}-title`}
                    class="font-clash font-semibold text-4xl md:text-5xl xl:text-6xl leading-none"
                    style={`color: ${style.hex}`}
                  >
                    {value.name}
                  </h3>
                  <p class="mt-3 md:mt-4 max-w-sm text-lg md:text-xl font-bold leading-snug">{value.tagline}</p>
                </div>
                <div class="mt-6 lg:mt-0 lg:col-span-7 lg:col-start-6 max-w-2xl space-y-4 text-base leading-[1.6875] text-ashgray">
                  {value.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {value.id === 'openness' && (
                    <p class="pt-2 font-bold text-grey">
                      {content.openSource.before}<ExternalLink href={sourceUrl} campaign="values" class="underline decoration-2 underline-offset-4 hover:text-orange">{content.openSource.link}</ExternalLink>{content.openSource.after}
                    </p>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))
  }
</div>

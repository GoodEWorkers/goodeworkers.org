---
import Icon from '../icons/Icon.astro';
import Rich from '../Common/Rich.astro';
import community from '../../assets/illustrations/community.svg';
import { valueStyles } from './valueStyles';
import type { ValuesContent } from '../../i18n/pages';

interface Props {
  content: ValuesContent;
}

const { content } = Astro.props;
const byId = Object.fromEntries(content.values.map((value) => [value.id, value]));

// The copy's two pairs, as the charter's two rows.
const rows = [
  { label: content.groups.work, values: [byId.openness, byId.autonomy] },
  { label: content.groups.care, values: [byId.care, byId.solidarity] },
];
---

<!-- The charter: the four values at a glance on the paper sheet, two pairs in
     two rows. Each tile jumps to its value's text further down. -->
<section
  aria-label={content.charterLabel}
  class="mt-10 md:mt-14 -mx-4 md:-mx-8 px-4 md:px-8 pt-8 md:pt-12 bg-white text-black rounded-xl sm:rounded-2xl lg:rounded-3xl overflow-hidden"
>
  <p class="max-w-4xl text-xl md:text-2xl xl:text-[28px] font-medium leading-snug">
    <Rich text={content.pairs} />
  </p>

  <div class="mt-8 md:mt-12 space-y-8 lg:space-y-5">
    {
      rows.map((row) => (
        <div class="lg:grid lg:grid-cols-[11rem_minmax(0,1fr)] xl:grid-cols-[14rem_minmax(0,1fr)] lg:gap-5">
          <p class="text-xl md:text-2xl font-medium leading-tight lg:pt-7 xl:pt-8">{row.label}</p>
          <ul class="mt-3 lg:mt-0 grid sm:grid-cols-2 gap-3 md:gap-5">
            {row.values.map((value) => {
              const style = valueStyles[value.id];
              return (
                <li>
                  <a
                    href={`#${value.id}`}
                    class:list={[
                      'group relative flex h-full min-h-[19rem] transition-transform duration-200 ease-in hover:scale-[1.02] sm:min-h-[22rem] xl:min-h-[25rem] flex-col overflow-hidden rounded-2xl lg:rounded-3xl p-6 md:p-8 xl:p-10',
                      'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange',
                      style.tile,
                    ]}
                  >
                    <span class="relative z-10 font-clash font-semibold text-4xl md:text-5xl xl:text-6xl leading-none">
                      {value.name}
                    </span>
                    <span class="relative z-10 mt-3 md:mt-4 max-w-[13rem] md:max-w-[15rem] xl:max-w-[17rem] font-bold text-base md:text-lg leading-snug">
                      {value.tagline}
                    </span>
                    <span
                      class="relative z-10 mt-auto inline-flex h-11 w-11 items-center justify-center rounded-full border-2 border-current transition-transform duration-200 ease-out group-hover:translate-y-1 [&>svg]:h-5 [&>svg]:w-5"
                      aria-hidden="true"
                    >
                      <Icon name="arrow-down" />
                    </span>
                    <img
                      src={style.tileDoodle.src}
                      alt=""
                      width={style.tileDoodle.width}
                      height={style.tileDoodle.height}
                      class="absolute bottom-0 right-0 w-[52%] max-w-[21rem] max-h-[64%] object-contain object-right-bottom translate-x-[4%] translate-y-[4%] transition-transform duration-300 ease-out group-hover:-translate-y-[1%] group-hover:-rotate-2"
                    />
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>

  <!-- The community stands on the sheet's lower edge. Open Peeps by Pablo
       Stanley (CC0); decorative, so no alt text. -->
  <img
    src={community.src}
    alt=""
    width={community.width}
    height={community.height}
    loading="lazy"
    class="mt-14 md:mt-20 mx-auto block h-48 w-full object-cover object-bottom sm:h-auto max-w-5xl"
  />
</section>

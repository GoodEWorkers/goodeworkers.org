---
import Icon from '../icons/Icon.astro';
import Rich from '../Common/Rich.astro';
import ValueIllustration from '../Illustrations/ValueIllustration.astro';
import { typeset } from '../Common/typeset';
import { getLangFromPath } from '../../i18n/routes';
import { valueStyles } from './valueStyles';
import type { ValuesContent } from '../../i18n/pages';

interface Props {
  content: ValuesContent;
}

const { content } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
const t = (text: string) => typeset(text, lang);
const byId = Object.fromEntries(content.values.map((value) => [value.id, value]));

// The copy's two pairs, as the charter's two rows.
const rows = [
  { label: content.groups.work, values: [byId.openness, byId.autonomy] },
  { label: content.groups.care, values: [byId.care, byId.solidarity] },
];
---

<!-- The charter: the four values at a glance on the dark card (inset in the column, like the About card), two pairs in
     two rows. Each tile jumps to its value's text further down. Its grid (a label column, then two equal columns) is the
     one the page header and the value rows hang from. -->
<section
  aria-label={content.charterLabel}
  class="mt-10 md:mt-14 px-6 md:px-8 py-8 md:py-12 bg-black-light text-grey rounded-xl sm:rounded-2xl lg:rounded-3xl overflow-hidden"
  data-reveal="up"
>
  <!-- One weight of Inter, so the two pairs are told by brightness: the sentence rests, its key words light up. -->
  <p class="max-w-4xl text-xl md:text-2xl xl:text-[28px] font-medium leading-snug text-pretty text-grey/75 [&_strong]:text-white" data-split="lines">
    <Rich text={t(content.pairs)} />
  </p>

  <div class="mt-8 md:mt-12 space-y-8 lg:space-y-5">
    {
      rows.map((row) => (
        <div class="lg:grid lg:grid-cols-[11rem_minmax(0,1fr)] xl:grid-cols-[14rem_minmax(0,1fr)] lg:gap-5">
          <p class="text-xl md:text-2xl font-medium leading-tight text-balance lg:pt-7 xl:pt-8">{t(row.label)}</p>
          <ul class="mt-3 lg:mt-0 grid sm:grid-cols-2 gap-3 md:gap-5" data-stagger>
            {row.values.map((value) => {
              const style = valueStyles[value.id];
              return (
                <li>
                  <a
                    href={`#${value.id}`}
                    data-tilt
                    class:list={[
                      'group relative flex h-full min-h-[19rem] sm:min-h-[22rem] md:min-h-[24rem] xl:min-h-[25rem] flex-col overflow-hidden rounded-2xl lg:rounded-3xl p-6 md:p-8 xl:p-10',
                      'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange',
                      style.tile,
                    ]}
                  >
                    <span class="relative z-10 font-clash font-semibold text-4xl sm:text-[2rem] md:text-4xl lg:text-[2.5rem] xl:text-[clamp(3rem,4.2vw,3.75rem)] leading-none">
                      {value.name}
                    </span>
                    <span class="relative z-10 mt-3 md:mt-4 max-w-[14rem] md:max-w-[16rem] font-bold text-lg md:text-xl leading-snug text-balance">
                      {t(value.tagline)}
                    </span>
                    <span
                      class="relative z-10 mt-auto inline-flex h-11 w-11 items-center justify-center rounded-full border-2 border-current transition-transform duration-200 ease-out group-hover:translate-y-1 group-focus-visible:translate-y-1 [&>svg]:h-5 [&>svg]:w-5"
                      aria-hidden="true"
                    >
                      <Icon name="arrow-down" />
                    </span>
                    {/* The value's window at night, bottom right: 52% of the tile, nudged 4% past the corner so the tile clips it. The nudge is
                         on this wrapper: the drawing's own root takes no transform (it moves only through its inner groups). */}
                    <div class="absolute bottom-0 right-0 w-[52%] max-w-[21rem] translate-x-[4%] translate-y-[4%]">
                      <ValueIllustration value={value.id} context="tile" class="block h-auto w-full" />
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

---
import logoSvg from '../assets/images/goodeworkers.svg?raw';
import Hamburger from './Miscs/Hamburger.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
  contactAnchor,
  getContributorSlug,
  getLangFromPath,
  getProjectSlug,
  getRouteKey,
  routes,
} from '../i18n/routes';
import { t } from '../i18n/ui';

const lang = getLangFromPath(Astro.url.pathname);
const strings = t(lang);

const homeHref = routes.home[lang];
// Highlight "Contributors" on its index and individual pages, same for Projects.
const isContributors =
  getRouteKey(Astro.url.pathname) === 'contributors' ||
  getContributorSlug(Astro.url.pathname) !== undefined;
const isProjects =
  getRouteKey(Astro.url.pathname) === 'projects' ||
  getProjectSlug(Astro.url.pathname) !== undefined;
---

<div class="bg-black sticky inset-x-0 top-0 lg:mt-16 z-50" data-navbar>
  <nav
    class="relative flex justify-between items-center font-inter max-w-screen-2xl mx-auto px-4 md:px-8 pt-2 pb-2 md:pt-4 md:pb-4 text-grey"
  >
    <a href={homeHref} aria-label={strings.org.homeAriaLabel}>
      <span
        class="inline-block w-[110px] h-[44px] md:w-[160px] md:h-[63px] [&>svg]:w-full [&>svg]:h-full"
        set:html={logoSvg}
      />
    </a>
    <div class="hidden md:flex md:items-center md:space-x-8">
      <ul class="flex space-x-12 font-bold">
        <li class="flex items-center">
          <a
            href={routes.contributors[lang]}
            aria-current={isContributors ? 'page' : undefined}
            class:list={[
              'transition-colors duration-200 hover:text-orange focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange',
              isContributors ? 'text-orange' : 'text-grey',
            ]}
          >
            {strings.nav.contributors}
          </a>
        </li>
        <li class="flex items-center">
          <a
            href={routes.projects[lang]}
            aria-current={isProjects ? 'page' : undefined}
            class:list={[
              'transition-colors duration-200 hover:text-orange focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange',
              isProjects ? 'text-orange' : 'text-grey',
            ]}
          >
            {strings.nav.projects}
          </a>
        </li>
        <li>
          <a
            href={contactAnchor(lang, 'nav')}
            class="border-orange border-2 -ml-2 px-3 py-1 rounded-full hover:bg-orange hover:text-black transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange"
          >
            {strings.nav.contact}
          </a>
        </li>
      </ul>
      <LanguageSwitcher />
    </div>
    <button
      type="button"
      class="md:hidden relative z-50"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">{strings.nav.menu}</span>
      <Hamburger />
    </button>
    <div
      id="mobile-menu"
      class="hidden md:hidden absolute top-0 inset-x-0 z-40 mobile-menu"
      data-menu-panel
    >
      <ul class="bg-black min-h-[100dvh] text-white font-bold text-xl pt-12">
        <li class="pl-16 pr-4 py-3">
          <a
            href={routes.contributors[lang]}
            class="hover:text-orange block w-full h-full"
            aria-current={isContributors ? 'page' : undefined}
            data-menu-link
          >
            {strings.nav.contributors}
          </a>
        </li>
        <li class="pl-16 pr-4 py-3">
          <a
            href={routes.projects[lang]}
            class="hover:text-orange block w-full h-full"
            aria-current={isProjects ? 'page' : undefined}
            data-menu-link
          >
            {strings.nav.projects}
          </a>
        </li>
        <li class="pl-16 pr-4 py-3">
          <a
            href={contactAnchor(lang, 'nav-mobile')}
            class="hover:text-orange block w-full h-full"
            data-menu-link
          >
            {strings.nav.contact}
          </a>
        </li>
        <li class="pl-16 pr-4 py-3">
          <LanguageSwitcher variant="menu" />
        </li>
      </ul>
    </div>
  </nav>
</div>

<style>
  .mobile-menu {
    transition: opacity 100ms ease-in, transform 100ms ease-in;
    transform: translateY(-0.5rem);
    opacity: 0;
  }
  .mobile-menu.is-open {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  function setupNavbar() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    const hamburger = document.querySelector<HTMLElement>('[data-hamburger]');
    if (!toggle || !panel || !hamburger) return;

    const close = () => {
      panel.classList.add('hidden');
      panel.classList.remove('is-open');
      hamburger.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.removeProperty('overflow');
    };
    const open = () => {
      panel.classList.remove('hidden');
      // next frame to allow transition
      requestAnimationFrame(() => panel.classList.add('is-open'));
      hamburger.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      // Stop the page scrolling behind the full-screen overlay.
      document.body.style.overflow = 'hidden';
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? close() : open();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      close();
      toggle.focus();
    });

    panel.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((a) => {
      a.addEventListener('click', () => close());
    });
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>

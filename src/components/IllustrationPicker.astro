---
// The designer's illustration picker (DESIGN.md, Illustrations). A page carries only this inert <template> and one short script:
// the picker itself (src/scripts/motion/picker.ts) is downloaded, and the panel cloned out of the template, only for a link that asks
// for it (?pick, ?illo=...) or a browser that stored a choice (localStorage.illoPick). Visitors get neither the panel nor its code.
// The panel's rows (one per subject, one thumbnail per style) are built by the script, so the styles and subjects live there.
---

<template id="illo-picker">
  <aside
    data-illo-panel
    aria-label="Illustrations"
    class="fixed bottom-4 right-4 z-[150] w-[22rem] max-w-[calc(100vw-1rem)] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-2xl border border-white/15 bg-black-light p-4 text-sm text-grey"
  >
    <div class="flex items-center justify-between">
      <p class="font-clash text-xl font-semibold leading-none">Illustrations</p>
      <button
        type="button"
        data-act="close"
        aria-label="Close"
        class="-mr-2 flex h-9 w-9 items-center justify-center rounded-full text-xl leading-none hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange"
      >
        &times;
      </button>
    </div>
    <div data-rows class="mt-3 space-y-3"></div>
    <button
      type="button"
      role="switch"
      aria-checked="false"
      data-act="same"
      class="group mt-4 flex items-center gap-3 rounded-lg py-1 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange"
    >
      <span aria-hidden="true" class="relative h-5 w-9 shrink-0 rounded-full bg-white/25 transition-colors group-aria-checked:bg-orange">
        <span class="absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-white-pure transition-transform group-aria-checked:translate-x-4"></span>
      </span>
      Same style everywhere
    </button>
    <div class="mt-3 flex gap-2">
      <button
        type="button"
        data-act="copy"
        class="rounded-full bg-orange px-4 py-2 font-bold text-white-pure hover:bg-orange/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Copy link
      </button>
      <button
        type="button"
        data-act="reset"
        class="rounded-full border border-white/30 px-4 py-2 font-bold hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Reset
      </button>
    </div>
    <!-- The fallback when the clipboard is refused: the link, selected, to copy by hand. -->
    <input
      data-link
      readonly
      hidden
      aria-label="Link to this choice"
      class="mt-3 w-full rounded-lg border border-white/20 bg-black px-3 py-2 text-xs text-grey"
    />
  </aside>
</template>

<script>
  // Only a link that asks for it or a stored choice wakes the picker; for everyone else this is all there is of it.
  try {
    const query = new URLSearchParams(location.search);
    if (query.has('pick') || query.has('illo') || localStorage.getItem('illoPick') !== null) void import('../scripts/motion/picker.ts');
  } catch {
    // storage blocked: no picker, no harm
  }
</script>

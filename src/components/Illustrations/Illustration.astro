---
// The root every piece of the "Windows at night" series shares (see DESIGN.md, Illustrations): one viewBox, one pen (4 units,
// round), the custom properties of the ground it sits on (illustration.css), and the hooks illos.ts reads. Decorative.
// Layers are classes, not ids: a page shows each value twice (its tile and its row), and a repeated id breaks whatever
// points at it. No drawing carries an id.
import './illustration.css';

interface Props {
  /** The piece, also its seed: tile and row of one value breathe in step. */
  name: string;
  /** 800x400 (the hospital) instead of 400x300. */
  wide?: boolean;
  /** The ground: a value tile (paper light), the night (the value's colour spills), or the paper sheet (yellow light). */
  context?: 'tile' | 'night' | 'paper';
  class?: string;
  [attr: string]: unknown;
}

const { name, wide = false, context = 'tile', class: className, ...rest } = Astro.props;
---

<svg
  viewBox={wide ? '0 0 800 400' : '0 0 400 300'}
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="#111"
  stroke-width="4"
  stroke-linecap="round"
  stroke-linejoin="round"
  data-illo={name}
  class:list={[`illo-${context}`, className]}
  {...rest}
>
  <slot />
</svg>

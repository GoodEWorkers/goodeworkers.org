---
import { getLangFromPath, routes } from '../i18n/routes';
import { t } from '../i18n/ui';

const lang = getLangFromPath(Astro.url.pathname);
const { notFound } = t(lang);
---

{/* Set like the Thanks page: one dark card in the column, the house pill back home. The numeral is display type,
    not text: the heading below says what happened, so it is hidden from assistive tech. */}
<div class="text-white bg-black-light my-10 rounded-3xl px-6 md:px-8" data-reveal="up">
  <main id="main-content" class="py-16 md:py-24">
    <div class="max-w-screen-md mx-auto">
      <p class="font-clash font-bold text-7xl sm:text-8xl leading-none text-orange" aria-hidden="true" data-split="chars">{notFound.code}</p>
      <h1 class="mt-6 text-3xl sm:text-4xl lg:text-5xl font-clash font-bold" data-split="lines">{notFound.title}</h1>
      <p class="mt-8 text-base md:text-lg text-ashgray" data-reveal="up" data-delay="0.15">{notFound.text}</p>
      <a
        href={routes.home[lang]}
        class="inline-block mt-12 bg-orange text-white-pure px-7 py-4 rounded-full
               font-clash font-bold text-xl hover:scale-105
               transition-transform ease-out
               focus-visible:outline focus-visible:outline-2
               focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        {notFound.cta}
      </a>
    </div>
  </main>
</div>

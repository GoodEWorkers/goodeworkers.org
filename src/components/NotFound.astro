---
import { getLangFromPath, routes } from '../i18n/routes';
import { t } from '../i18n/ui';
import { typeset } from './Common/typeset';

const lang = getLangFromPath(Astro.url.pathname);
const { notFound } = t(lang);
---

{/* Set like the Thanks page: one dark card in the column, the house pill back home. The numeral is display type, not text:
    the heading below says what happened, so it is hidden from assistive tech. It is the card's picture. From lg it stands at the
    right and runs off the card's right and bottom edges (the card clips it), so it is a frame, not a label floating in the dark;
    below lg it sits above the words at the width of the card (never wider: split into chars it would wrap, and the card would be
    taller than the page is once the split reverts). The words sit on the card's own padding, like the other dark cards. */}
<div class="sheet relative overflow-hidden text-white bg-black-light my-10" data-reveal="up">
  <main id="main-content" class="py-12 md:py-16 lg:flex lg:min-h-[26rem] lg:items-center lg:py-16">
    <p
      class="-ml-[0.01em] mb-6 md:mb-8 font-clash font-bold text-[min(8.75rem,calc((100vw_-_2rem)/2.2))] sm:text-[11rem] md:text-[14rem] leading-none whitespace-nowrap text-orange select-none lg:mb-0 lg:absolute lg:-ml-0 lg:-right-[0.07em] lg:-bottom-[0.25em] lg:text-[clamp(15rem,27vw,25rem)]"
      aria-hidden="true"
      data-split="chars"
    >{notFound.code}</p>
    <div class="relative lg:max-w-[21rem] xl:max-w-[26rem]">
      <h1 class="text-3xl sm:text-4xl lg:text-4xl xl:text-5xl font-clash font-bold text-balance" data-split="lines">{notFound.title}</h1>
      <p class="mt-6 text-base md:text-lg text-ashgray text-pretty" data-reveal="up" data-delay="0.15">{typeset(notFound.text, lang)}</p>
      <a
        href={routes.home[lang]}
        class="inline-block mt-10 md:mt-12 bg-orange text-white-pure px-8 py-5 rounded-full
               font-clash font-bold text-2xl hover:scale-105 focus-visible:scale-105
               transition-transform ease-out
               focus-visible:outline focus-visible:outline-2
               focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        {typeset(notFound.cta, lang)}
      </a>
    </div>
  </main>
</div>

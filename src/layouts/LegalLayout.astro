---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  /** Per-page meta description; falls back to the dictionary's legal meta. */
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout metaKey="legal" title={`${title} | GoodEWorkers`} description={description}>
  <div class="text-white bg-black-light my-10 rounded-3xl px-6 md:px-8" data-reveal="up">
    <main id="main-content" class="min-h-svh py-8">
      <div class="max-w-screen-md mx-auto">
        <h1 class="mt-14 text-3xl sm:text-4xl lg:text-5xl xl:text-[54px]" data-split="lines">
          {title}
        </h1>
        <div class="mt-10 legal-content">
          <slot />
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style is:global>
  .legal-content p,
  .legal-content pre {
    margin-top: 1rem;
  }
  /* The copy indents its address and registration blocks with four spaces, which markdown reads as code: Shiki paints
     them as a dark monospace box, with inline styles that need !important to beat. They are prose, so set them as prose. */
  .legal-content pre,
  .legal-content code {
    font: inherit;
    color: inherit !important;
    background: transparent !important;
    padding: 0;
    overflow: visible !important;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>

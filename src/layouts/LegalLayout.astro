---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout metaKey="legal">
  <div class="font-inter text-white bg-black-light mx-8 my-10 rounded-3xl">
    <main class="max-w-screen-2xl mx-auto min-h-screen px-4 py-8">
      <div class="max-w-screen-md mx-auto">
        <h1 class="mt-14 text-3xl sm:text-4xl lg:text-5xl xl:text-[54px]">
          {title}
        </h1>
        <div class="mt-10 legal-content">
          <slot />
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style is:global>
  .legal-content p {
    margin-top: 1rem;
  }
</style>

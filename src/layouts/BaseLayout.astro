---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  SITE,
  absoluteUrl,
  getAlternates,
  getLangFromPath,
  defaultLang,
  langCodes,
  languages,
} from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  /** Which `meta` entry of the dictionary to use for title/description. */
  metaKey?: 'home' | 'legal' | 'contributors' | 'projects' | 'notFound' | 'thanks';
  /** Overrides the dictionary title (used by content-driven pages). */
  title?: string;
  description?: string;
  /** Set on pages that must stay out of the index (404, thank-you pages) —
   *  no canonical, no hreflang. */
  noindex?: boolean;
  /** Opts the page out of the shared content column, for pages that manage
   *  their own horizontal rhythm (the full-screen 404). Everything else should
   *  leave this off — see the column note below. */
  fullBleed?: boolean;
}

const {
  metaKey = 'home',
  title,
  description,
  noindex = false,
  fullBleed = false,
} = Astro.props;

const lang = getLangFromPath(Astro.url.pathname);
const strings = t(lang);
const meta = strings.meta[metaKey];

// One spelling, everywhere. The site previously rendered the name five ways
// ("GoodEworkers", "GoodEWorkers", "GoodeWorkers", "Good eWorkers",
// "Goodeworkers.org"), which splits brand search and breaks recall. The
// lowercase-e wordmark in the H1 is a deliberate logo treatment; prose and
// metadata now agree on this form.
const SITE_NAME = 'GoodEWorkers';

const pageTitle = title ?? meta.title;
const pageDescription = description ?? meta.description;

const canonical = absoluteUrl(Astro.url.pathname);
const alternates = getAlternates(Astro.url.pathname);
const ogImage = `${SITE}/og-image.png`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      // `NGO` is a direct subtype of Organization and the precise entity type
      // here — it is the input to nonprofit-specific treatment and to entity
      // resolution in AI answers.
      '@type': 'NGO',
      '@id': `${SITE}/#organization`,
      name: SITE_NAME,
      legalName: SITE_NAME,
      url: `${SITE}/`,
      // NOTE: this is still the favicon. At 198x198 it clears Google's 112x112
      // minimum so it validates, but it is the square icon mark rather than the
      // horizontal wordmark. Replace with a dedicated /logo-512.png when one
      // exists, and update width/height below.
      logo: {
        '@type': 'ImageObject',
        '@id': `${SITE}/#logo`,
        url: `${SITE}/favicon.png`,
        contentUrl: `${SITE}/favicon.png`,
        width: 198,
        height: 198,
        caption: SITE_NAME,
      },
      image: { '@id': `${SITE}/#logo` },
      description: strings.org.description,
      email: 'hello@goodeworkers.org',
      // Machine-readable statement that we serve French speakers.
      knowsLanguage: langCodes.map((code) => languages[code].htmlLang),
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Legal Place, 60 Rue François 1er',
        postalCode: '75008',
        addressLocality: 'Paris',
        addressCountry: 'FR',
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'customer support',
          email: 'hello@goodeworkers.org',
          availableLanguage: ['fr', 'en'],
          areaServed: 'FR',
        },
      ],
      // `sameAs` is Google's primary entity-reconciliation signal. Only verified
      // profiles belong here — a sameAs pointing at a 404 is worse than none.
      // Add the LinkedIn company page once it exists.
      sameAs: ['https://github.com/GoodEWorkers'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services for nonprofits',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Website creation',
              serviceType: 'Website design and development',
              provider: { '@id': `${SITE}/#organization` },
              audience: {
                '@type': 'Audience',
                audienceType: 'Nonprofit organizations and associations',
              },
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Content marketing',
              serviceType: 'Content marketing and social media management',
              provider: { '@id': `${SITE}/#organization` },
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'SEO optimization',
              serviceType: 'Search engine optimization',
              provider: { '@id': `${SITE}/#organization` },
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Audits and advice',
              serviceType: 'Digital audit and advisory',
              provider: { '@id': `${SITE}/#organization` },
            },
          },
        ],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      name: SITE_NAME,
      url: `${SITE}/`,
      inLanguage: langCodes.map((code) => languages[code].htmlLang),
      publisher: { '@id': `${SITE}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <!-- `maximum-scale` / `user-scalable=no` removed: they blocked pinch-zoom on
         Android Chrome and in-app webviews (WCAG 1.4.4). The layout is already
         fully responsive, so there is no design cost to allowing zoom. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <!-- body is #111, so without this Android Chrome keeps light browser chrome
         against a near-black page. -->
    <meta name="theme-color" content="#111111" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Self-referencing canonical: /index.html also resolves on Netlify, so this
         tells Google which URL is authoritative. Skipped on noindex pages —
         a 404 has no canonical URL to point at. -->
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex && (
        <>
          {langCodes.map((code) => (
            <link rel="alternate" hreflang={languages[code].htmlLang} href={alternates[code]} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternates[defaultLang]} />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {
      langCodes
        .filter((code) => code !== lang)
        .map((code) => (
          <meta property="og:locale:alternate" content={languages[code].ogLocale} />
        ))
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="GoodEWorkers - Helping nonprofits go remote"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <!-- Per-page extras (e.g. a ProfilePage JSON-LD on contributor pages). -->
    <slot name="head" />
  </head>
  <body class="font-inter">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:m-2
             focus:rounded focus:bg-yellow focus:px-4 focus:py-2 focus:text-black
             focus:font-bold"
    >
      {strings.nav.skipToContent}
    </a>
    <Navbar />
    <!--
      The shared content column. Every page sits in the same box as the navbar
      and the footer, which both use this exact recipe — that is what puts page
      content on the same left/right margins as the logotype and the Contact
      button (issue #45).

      Two rules for anything placed inside it:

        * Do not add a second layer of horizontal padding. A panel with its own
          `px-8` inside this `px-8` pushes its content 32px past the logotype,
          which is the bug #45 reported.
        * A surface that must span wider than the column (the hero's white
          panel) breaks out and re-applies the padding — `-mx-4 md:-mx-8
          px-4 md:px-8` — so the panel bleeds but its content stays on the
          column. A *card* that sits within the column (the About panel, the
          legal panel) keeps its own padding and is deliberately inset.
    -->
    <div class:list={[!fullBleed && 'max-w-screen-2xl mx-auto px-4 md:px-8']}>
      <slot />
    </div>
    <Footer />
  </body>
</html>

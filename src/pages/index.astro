---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/Landing/LandingHeader.astro';
import Hero from '../components/Landing/Hero.astro';
import Why from '../components/Landing/Why.astro';
import About from '../components/Landing/About.astro';
---

<BaseLayout metaKey="home">
  <div class="font-inter max-w-screen-2xl mx-auto px-4 md:px-8">
    <LandingHeader />
    <main id="main-content">
      <Hero />
      <Why />
      <About />
    </main>
  </div>
</BaseLayout>

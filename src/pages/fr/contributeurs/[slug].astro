---
import { getCollection } from 'astro:content';
import ContributorPage from '../../../components/Contributors/ContributorPage.astro';

// French contributor pages: contributors/<slug>.yaml -> /fr/contributeurs/<slug>/
// The slug is shared with the English version; the pairing lives in
// contributorPath() (src/i18n/routes.ts) so hreflang stays correct.
export async function getStaticPaths() {
  const entries = await getCollection('contributors');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<ContributorPage contributor={entry} />
